# Copy to apps/demo/.env. Next.js (`pnpm dev`) and Docker Compose (`pnpm keycloak`) both read it.

# Where the browser reaches this app. Keycloak's redirect URI for demo-web is built from it.
APP_URL=http://localhost:3002
# Where the Keycloak container reaches this app for back-channel logout.
APP_INTERNAL_URL=http://host.docker.internal:3002
# The API behind /api/v1. The demo ships a fake one at /mock (routes /mock/api/v1/*) that verifies Keycloak tokens.
API_BASE_URL=http://localhost:3002/mock

# Keycloak from compose.yaml. 8081 is usually taken by another project's Keycloak.
KEYCLOAK_PORT=8082
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Realm whimui-demo (apps/demo/keycloak/realms). Only imported when the realm does not exist yet.
AUTH_ISSUER=http://localhost:8082/realms/whimui-demo
# Same as AUTH_ISSUER when nothing sits between Next and Keycloak.
AUTH_ISSUER_INTERNAL=http://localhost:8082/realms/whimui-demo
AUTH_CLIENT_ID=demo-web
# Feeds both the realm import (client demo-web) and the BFF: openssl rand -base64 32
AUTH_CLIENT_SECRET=change-me
# Encrypts the session cookies of the BFF: openssl rand -base64 32
AUTH_SECRET=change-me-change-me-change-me-change-me
# Audience the fake API requires in access tokens (the demo-api client's audience mapper).
API_AUDIENCE=demo-api

# Test user created by the realm import: username demo
DEMO_USER_PASSWORD=change-me
