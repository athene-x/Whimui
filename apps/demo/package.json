{
  "name": "demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "keycloak": "docker compose up -d",
    "keycloak:down": "docker compose down",
    "lint": "oxlint && node scripts/check-boundaries.mjs",
    "format": "oxfmt ./src ./scripts --write",
    "format:check": "oxfmt ./src ./scripts --check",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test scripts/check-boundaries.test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@athene-x/whimui": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "better-auth": "^1.7.18",
    "jose": "^6.2.16",
    "ky": "^2.2.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "^7.0.2"
  }
}
