{
  "name": "playground",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "format": "oxfmt ./src ./scripts --write",
    "format:check": "oxfmt ./src ./scripts --check",
    "typecheck": "next typegen && tsc --noEmit",
    "registry:build": "shadcn build --output public/r",
    "tokens:check": "node scripts/check-tokens.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm tokens:check && pnpm registry:check && pnpm registry:build",
    "registry:check": "node scripts/check-registry.mjs && node --test scripts/check-registry.test.mjs"
  },
  "dependencies": {
    "@athenex/web-core": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "ky": "^2.2.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-number-format": "^5.4.5",
    "react-resizable-panels": "^4.14.8",
    "recharts": "3.10.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
