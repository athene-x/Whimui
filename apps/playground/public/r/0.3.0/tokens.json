{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "tokens",
  "title": "Semantic tokens",
  "description": "success / warning / critical / info colour variables the components use; the CLI maps them into @theme inline. Retune the values to the app's palette.",
  "cssVars": {
    "light": {
      "success": "oklch(0.6 0.15 150)",
      "success-tint": "oklch(0.96 0.04 150)",
      "success-foreground": "oklch(0.35 0.1 150)",
      "warning": "oklch(0.7 0.16 70)",
      "warning-tint": "oklch(0.97 0.05 85)",
      "warning-foreground": "oklch(0.42 0.1 60)",
      "critical": "oklch(0.6 0.22 25)",
      "critical-tint": "oklch(0.95 0.04 20)",
      "critical-foreground": "oklch(0.4 0.17 25)",
      "info": "oklch(0.55 0.2 260)",
      "info-tint": "oklch(0.95 0.03 260)",
      "info-foreground": "oklch(0.4 0.15 260)"
    },
    "dark": {
      "success": "oklch(0.72 0.17 150)",
      "success-tint": "oklch(0.27 0.06 150)",
      "success-foreground": "oklch(0.85 0.1 150)",
      "warning": "oklch(0.8 0.16 75)",
      "warning-tint": "oklch(0.3 0.07 75)",
      "warning-foreground": "oklch(0.9 0.09 85)",
      "critical": "oklch(0.72 0.18 25)",
      "critical-tint": "oklch(0.27 0.07 25)",
      "critical-foreground": "oklch(0.87 0.08 25)",
      "info": "oklch(0.7 0.15 260)",
      "info-tint": "oklch(0.27 0.06 260)",
      "info-foreground": "oklch(0.85 0.08 260)"
    }
  },
  "type": "registry:theme"
}
