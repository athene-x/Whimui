{
  "name": "starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "oxlint && node scripts/check-boundaries.mjs",
    "format": "oxfmt ./src ./scripts --write",
    "format:check": "oxfmt ./src ./scripts --check",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test scripts/check-boundaries.test.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@athenex/web-core": "workspace:*",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^9.3.1",
    "ky": "^2.2.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.11",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "^7.0.2"
  }
}
