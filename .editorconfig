# EditorConfig for apps/web: https://editorconfig.org
# Mirrors .oxfmtrc.json (oxfmt) so editors agree with the formatter:
# 2-space indent, LF, final newline, 100-column guide.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

# Markdown: trailing double-space is a hard line break.
[*.md]
trim_trailing_whitespace = false

# Lockfile is generated by pnpm; leave it alone.
[pnpm-lock.yaml]
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
