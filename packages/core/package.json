{
  "name": "@athene-x/whimui",
  "version": "0.3.0",
  "description": "WhimUI standard web kit: framework-level logic shared by the Next.js apps (server-paged lists, API client, form core, Keycloak BFF helpers, ui messages).",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/athene-x/Whimui.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./list-query": "./src/list-query/index.ts",
    "./api": "./src/api/index.ts",
    "./query": "./src/query/index.ts",
    "./form": "./src/form/index.ts",
    "./auth": "./src/auth/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./messages/en": "./src/messages/en.ts",
    "./messages/th": "./src/messages/th.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt ./src --write",
    "format:check": "oxfmt ./src --check",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "^1.7.12",
    "date-fns": "^4.4.0",
    "jose": "^6.2.3",
    "ky": "^2.2.0",
    "next-intl": "^4.14.9",
    "react": "^19.2.0",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "jose": {
      "optional": true
    },
    "next-intl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^9.3.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "better-auth": "^1.7.18",
    "date-fns": "^4.4.0",
    "jose": "^6.2.16",
    "ky": "^2.2.0",
    "next-intl": "^4.14.9",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "react": "19.3.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
