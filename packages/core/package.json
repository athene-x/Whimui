{
  "name": "@athenex/web-core",
  "version": "0.1.0",
  "description": "Athenex standard web kit: framework-level logic shared by the Next.js apps (server-paged lists, API client, form core, Keycloak BFF helpers, ui messages).",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": ["src", "README.md"],
  "exports": {
    ".": "./src/index.ts",
    "./list-query": "./src/list-query/index.ts",
    "./api": "./src/api/index.ts",
    "./form": "./src/form/index.ts",
    "./auth": "./src/auth/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./messages/en": "./src/messages/en.ts",
    "./messages/th": "./src/messages/th.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt ./src --write",
    "format:check": "oxfmt ./src --check",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^9.3.1",
    "better-auth": "^1.7.12",
    "date-fns": "^4.4.0",
    "ky": "^2.2.0",
    "next-intl": "^4.14.9",
    "react": "^19.2.0",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "better-auth": { "optional": true },
    "date-fns": { "optional": true },
    "next-intl": { "optional": true }
  },
  "devDependencies": {
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^9.3.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "better-auth": "^1.7.14",
    "date-fns": "^4.4.0",
    "ky": "^2.2.0",
    "next-intl": "^4.14.9",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "react": "19.3.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
